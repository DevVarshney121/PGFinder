# Provision a PostgreSQL database (for example Neon via the Vercel Marketplace)
POSTGRES_URL=
# Generate a long random value, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Vercel Blob read/write token; configure in Vercel project settings
BLOB_READ_WRITE_TOKEN=
# Public WhatsApp business number, international digits only, no + or spaces
WHATSAPP_NUMBER=
SITE_URL=http://localhost:3000
NODE_ENV=development
